# Clé secrète (32 caractères minimum) : python3 -c "import secrets;print(secrets.token_urlsafe(48))"
MP_SECRET_KEY=
MP_PUBLIC_ORIGIN=https://mail.exemple.fr
# Jeton exigé pour créer le compte au premier lancement (recommandé si l'appli est exposée
# sur Internet avant la création du compte) : python3 -c "import secrets;print(secrets.token_urlsafe(24))"
#MP_SETUP_TOKEN=
# Jeton obtenu avec `claude setup-token` (ou à saisir dans Réglages > Claude)
CLAUDE_CODE_OAUTH_TOKEN=
# « Se connecter avec Google » (facultatif, voir README › Connexion Google)
# Adresse de retour : {MP_PUBLIC_ORIGIN}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# « Se connecter avec Microsoft » (Outlook/Hotmail ; voir README › Connexion Microsoft)
# Adresse de retour : {MP_PUBLIC_ORIGIN}/api/oauth/microsoft/callback
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
TZ=Europe/Paris
DATA_DIR=/data
# Propriétaire de ./data sur l'hôte (défaut 1000:1000 ; voir `id -u` / `id -g`)
#MP_UID=1000
#MP_GID=1000
